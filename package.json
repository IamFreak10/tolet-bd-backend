{
  "name": "tolet_bd_backend",
  "version": "1.0.0",
  "description": "Backend API for To-Let BD with Prisma and Better Auth",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:prod": "pm2 start ecosystem.config.cjs",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "build": "prisma generate && prisma db push",
    "postinstall": "prisma generate && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "better-auth": "^1.1.20",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "pm2": "^5.3.1",
    "prisma": "^6.4.0"
  }
}
